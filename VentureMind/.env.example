# ──────────────────────────────────────────────────────────────
# VentureMind — Environment Configuration
# Copy this file to .env and adjust values as needed.
# ──────────────────────────────────────────────────────────────

# --- Database ---
# SQLite connection paths (relative to project root)
DATABASE_URL=sqlite:///data/reports/reports.db
DRAGONFLY_URL=sqlite:///data/reports/shared_memory.db

# --- Ollama LLM ---
# Base URL of the local Ollama server
OLLAMA_BASE_URL=http://localhost:11434

# Model names — pull these with: ollama pull <model>
OLLAMA_ORCHESTRATOR_MODEL=qwen2.5:7b
OLLAMA_ANALYST_MODEL=qwen2.5:7b
OLLAMA_SUMMARY_MODEL=qwen2.5:7b
OLLAMA_EMBED_MODEL=nomic-embed-text

# --- Report Output ---
REPORTS_OUTPUT_DIR=data/reports

# --- Agent Behaviour ---
MAX_SEARCH_RESULTS=5
MAX_PDF_PAGES=20
AGENT_TIMEOUT_SECONDS=180
PARALLEL_AGENT_LIMIT=4

# --- Logging ---
LOG_LEVEL=INFO
