# CodeLens AI — Environment Configuration
# Copy this file to .env and fill in values

# GitHub API personal access token (required for PR access)
GITHUB_TOKEN=""

# GitHub webhook secret for payload signature verification
GITHUB_WEBHOOK_SECRET=""

# Ollama server settings
OLLAMA_BASE_URL="http://localhost:11434"
OLLAMA_MODEL_CODE="codellama"
OLLAMA_MODEL_REASON="deepseek-coder"
OLLAMA_EMBED_MODEL="nomic-embed-text"

# Storage paths
CHROMA_PATH="data/chroma"
SQLITE_PATH="data/sqlite/codelens.db"
EXCEL_PATH="data/excel"

# DragonflyDB (Redis-compatible) URL
DRAGONFLY_URL="redis://localhost:6379/0"

# LLM Context settings
MAX_CONTEXT_TOKENS=4096

# Logging
LOG_LEVEL="INFO"
