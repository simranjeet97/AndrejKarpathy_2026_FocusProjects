# LLM Settings
ANTHROPIC_API_KEY=your-anthropic-api-key-here

# GitHub App Integration
GITHUB_APP_ID=your-github-app-id
GITHUB_APP_PRIVATE_KEY_PATH=/path/to/your/github-app.private-key.pem
GITHUB_WEBHOOK_SECRET=your-github-webhook-secret

# Databases and Queues
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/autoforge
REDIS_URL=redis://localhost:6379/0

# Sandbox Orchestration / Docker-in-Docker
DOCKER_HOST=tcp://localhost:2375
SANDBOX_IMAGE=autoforge-sandbox:latest
MAX_SANDBOX_CPU=0.5
MAX_SANDBOX_MEMORY_MB=512
